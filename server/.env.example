# LLM providers. Fallback order is DeepSeek → Groq → Google → OpenRouter;
# a provider with no key here is skipped entirely, so Groq alone still works.
DEEPSEEK_API_KEY= # https://platform.deepseek.com — primary. Cheap prompt-cache
                  # hits and better multilingual/tone than the Groq catalogue.
GROQ_API_KEY=     # Fallback. Fastest, but only gpt-oss + qwen3.6 remain.
GOOGLE_API_KEY=   # Optional, gemini-*/gemma-* models.
OPENROUTER_API_KEY= # Optional, everything else.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TMDB_API_KEY=
DB_PATH=          # Path to SQLite DB file (default: ./newsreader.db). Set to a volume path on Railway.
PORT=             # Server port (default: 3001)

# Access control. Leave empty for local dev; set BOTH once the backend is
# reachable from outside localhost. See README "Securing a deployed backend".
API_TOKEN=        # Bearer token required on every endpoint except /api/health
ALLOWED_ORIGINS=  # Comma-separated browser origins, e.g. https://newsdigest.example.org

# Timeouts
LLM_TIMEOUT_MS=   # Per-LLM-request timeout (default 90000)
RSS_TIMEOUT_MS=   # Per-feed fetch timeout (default 15000)

# Adzuna job source (optional). Without these, the Adzuna source is skipped.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Job search profile (optional, defaults target Senior Frontend Developer / Remote / EMEA).
# All comma-separated lists. See server/jobs/profile.js for defaults.
# JOB_ROLE=Senior Frontend Developer
# JOB_ROLE_KEYWORDS=Frontend,Front End,React,UI Engineer,Web Engineer
# JOB_SENIORITY_LEVELS=senior,staff,lead,principal
# JOB_STACK_KEYWORDS=React,TypeScript,JavaScript,Next.js,Vue,Angular
# JOB_EXCLUDE_KEYWORDS=devops,sre,android developer,ios developer
# JOB_REGION=EMEA
# JOB_REGION_COUNTRIES=United Kingdom,Germany,France,...
# JOB_REGION_SEARCH_TERMS=Remote,Europe,Germany,UK,France
# JOB_ADZUNA_COUNTRIES=gb,de,fr,nl,se,at,pl,es,it,ch
# JOB_REQUIRE_REMOTE=true
# Format: provider:slug[:displayName] — providers: greenhouse|lever|ashby|workable
# JOB_ATS_COMPANIES=greenhouse:gitlab:GitLab,ashby:vercel:Vercel,lever:plaid:Plaid
